# Copy this to /opt/reminder/reminder.env, fill in real values, then:
#   chmod 600 /opt/reminder/reminder.env
#   chown reminder:reminder /opt/reminder/reminder.env
# This file holds a secret token -- it must not be world-readable.

REMINDER_DB=/opt/reminder/reminder.db
REMINDER_TZ=America/New_York
# Generate with: openssl rand -hex 32
REMINDER_TOKEN=replace-this-with-a-real-generated-token
REMINDER_BIND=127.0.0.1:8080

# Leave the two lines below unset to disable push notifications.
REMINDER_NTFY_TOPIC=replace-with-an-unguessable-topic-name
REMINDER_NTFY_SERVER=https://ntfy.sh
